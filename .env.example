# Contoh env untuk development lokal
# Salin file ini menjadi .env dan isi dengan URL GAS milikmu (jangan commit .env).

# Server/proxy: dipakai Vercel api/index.js (process.env.GAS_URL) dan Vite dev proxy.
# P1-01: pakai GAS_URL (tanpa prefix VITE_) agar tidak ter-inline ke bundle client.
GAS_URL=https://script.google.com/macros/s/XXXX/exec

# Harus sama dengan Script Property API_KEY di Google Apps Script. Server-only.
GAS_API_KEY=ganti-dengan-string-acak-panjang

# Opsional: origin yang diizinkan, dipisah koma (default: laporan-pm-app.vercel.app + localhost:5173)
# ALLOWED_ORIGINS=https://laporan-pm-app.vercel.app,http://localhost:5173

# Client: base path API (tetap /api, di-proxy ke GAS_URL saat dev, via Vercel function saat prod)
VITE_API_URL=/api


